{
  "realm": "ayuvahak",
  "enabled": true,
  "displayName": "AyuVahak local reference realm",
  "clients": [
    {
      "clientId": "ayuvahak-local-client",
      "name": "AyuVahak local human client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:*"]
    },
    {
      "clientId": "transfer-agent",
      "name": "AyuVahak synthetic service client",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-only-not-a-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "AyuVahak API audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ayuvahak-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "AyuVahak service client reference",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "client_id",
            "claim.value": "transfer-agent",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "synthetic.person",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "local-only-not-a-secret",
          "temporary": false
        }
      ]
    }
  ]
}
