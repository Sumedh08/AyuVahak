# Template for the local launcher. Leave secret values blank; Start-AyuVahak.ps1
# generates per-installation local credentials and requires an explicit mode choice.
AYUVAHAK_DEPLOYMENT_MODE=
AYUVAHAK_DATABASE_NAME=ayuvahak
AYUVAHAK_DATABASE_USERNAME=ayuvahak
AYUVAHAK_DATABASE_PASSWORD=
AYUVAHAK_HTTP_PORT=8080
AYUVAHAK_KEYCLOAK_ADMIN_USERNAME=local-admin
AYUVAHAK_KEYCLOAK_ADMIN_PASSWORD=
AYUVAHAK_KEYCLOAK_PORT=8081
AYUVAHAK_OIDC_ISSUER=http://localhost:8081/realms/ayuvahak
AYUVAHAK_OIDC_JWK_SET_URI=http://keycloak:8080/realms/ayuvahak/protocol/openid-connect/certs
AYUVAHAK_OIDC_AUDIENCE=ayuvahak-api
AYUVAHAK_OIDC_CLIENT_ID=ayuvahak-local-client
AYUVAHAK_OIDC_SCOPE=openid profile
AYUVAHAK_OIDC_SERVICE_CLIENT_IDS=transfer-agent
AYUVAHAK_OIDC_ALLOW_HTTP=true
# Synthetic local-only delivered-event replay retention; deployments choose their own value.
AYUVAHAK_OUTBOX_DELIVERED_EVENT_RETENTION=PT720H
AYUVAHAK_IDEMPOTENCY_RECEIPT_LOCK_WAIT=PT5S
# Optional bounded documentation support; disabled by default and no API key is prefilled.
AYUVAHAK_OPERATOR_SUPPORT_ENABLED=false
AYUVAHAK_OPERATOR_SUPPORT_PROVIDER=DETERMINISTIC_LOCAL
AYUVAHAK_OPERATOR_SUPPORT_ENDPOINT=
AYUVAHAK_OPERATOR_SUPPORT_MODEL=
AYUVAHAK_OPERATOR_SUPPORT_SECRET_REFERENCE=
AYUVAHAK_OPERATOR_SUPPORT_ALLOWED_HOSTS=
AYUVAHAK_OPERATOR_SUPPORT_TIMEOUT=PT8S
AYUVAHAK_OPERATOR_SUPPORT_MAX_RESPONSE_BYTES=16384
AYUVAHAK_OPERATOR_SUPPORT_API_KEY=
